ENV=development

# Recommended for app runtime on IPv4/IPv6 networks:
# copy the exact "Session pooler" string from Supabase > Connect and replace [YOUR-PASSWORD].
# Example format:
# DATABASE_URL=postgresql://postgres.rmpwrvgxxnzzcjtgyrzd:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct connection works only when your environment supports IPv6:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rmpwrvgxxnzzcjtgyrzd.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.rmpwrvgxxnzzcjtgyrzd:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET_KEY=your_jwt_secret_key
JWT_EXPIRE_DAYS=7
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
